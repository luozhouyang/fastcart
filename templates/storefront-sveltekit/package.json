{
  "name": "@fastcart/storefront-sveltekit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:artifact": "vite build && wrangler deploy --dry-run --outdir .svelte-kit/bundle && node --experimental-strip-types scripts/package.mjs",
    "test:artifact": "node scripts/smoke.mjs",
    "build:artifact:preview": "node scripts/preview-build.mjs",
    "test:artifact:preview": "node scripts/preview-smoke.mjs",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@fastcart/storefront-build": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.0.0",
    "@sveltejs/kit": "^2.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "wrangler": "^4.158.0"
  }
}
