# Rust build output and local caches
target/
**/target/
.cargo-home/
**/.cargo-home/

# Version control and CI metadata
.git/
.github/
.gitignore
.editorconfig

# Local node and frontend artifacts
node_modules/
**/node_modules/
.pnpm-store/
**/.pnpm-store/
**/dist/
apps/storefront/.output/
apps/storefront/.nitro/
apps/storefront/.tanstack/
**/*.tsbuildinfo

# Runtime data and backups never belong in an image
data/
crates/*/data/
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm

# Local configuration and secrets
config/config.toml
.env
.env.*
!.env.example

# Tests, fixtures, docs, screenshots and local tooling state
tests/
apps/*/test/
**/__tests__/
**/*.test.*
**/*.spec.*
docs/
.livingdocs/
playwright-report/
test-results/
coverage/
.playwright-mcp/
*.png
*.log
.DS_Store
