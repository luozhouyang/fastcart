# Optional overrides applied after config/config.toml is loaded.
FASTCART_SERVER_HOST=0.0.0.0
FASTCART_SERVER_PORT=8080
FASTCART_LOG_LEVEL=info

# Optional signing secret enabling draft page preview. When absent, preview
# token issuance and GET /preview/{path} respond with 501 Not Implemented.
# FASTCART_PREVIEW_SECRET=long-random-preview-secret

# Admin application origin used in Feishu notification deep links.
# FASTCART_ADMIN_BASE_URL=https://admin.example.com

# Inquiry attachment limits.
# FASTCART_INQUIRY_MAX_UPLOAD_BYTES=26214400
# FASTCART_INQUIRY_UPLOAD_TTL_SECONDS=3600

# Stripe payment provider. Both values must be set for the provider to be
# registered; the manual/sandbox provider remains available either way.
# FASTCART_STRIPE_SECRET_KEY=sk_test_...
# FASTCART_STRIPE_WEBHOOK_SECRET=whsec_...
