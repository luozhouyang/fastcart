{
  "schema_version": "1",
  "id": "chat-widget",
  "name": "Live Chat",
  "version": "1.2.0",
  "description": "Storefront chat bubble with an admin inbox.",
  "api_version": 2,
  "runtime": {
    "engine": "workerd",
    "compatibility_date": "2026-11-01",
    "compatibility_flags": ["nodejs_compat"]
  },
  "entry": {
    "type": "worker",
    "path": "worker/index.js"
  },
  "capabilities": {
    "data": ["catalog.read", "orders.read", "customers.read"],
    "storage": ["kv.read", "kv.write"],
    "events": ["order.placed"],
    "network": ["api.openai.com"],
    "admin": ["admin.ui"],
    "storefront": ["store.read"]
  },
  "extensions": {
    "admin": [
      {
        "target": "admin.nav.section",
        "label": "Live Chat",
        "route": "/apps/chat-widget"
      },
      {
        "target": "admin.page.settings.tabs",
        "title": "Live Chat",
        "entry": "ui/settings.html",
        "height": 520
      },
      {
        "target": "admin.page.orders.details.side",
        "title": "Conversations",
        "entry": "ui/order-sidebar.html",
        "height": 240
      }
    ],
    "storefront": [
      {
        "kind": "embed",
        "placement": "body:end",
        "entry": "storefront/boot.js",
        "css": "storefront/boot.css",
        "pages": ["*"]
      }
    ]
  },
  "settings": {
    "schema": {
      "type": "object",
      "properties": {
        "accent": {
          "type": "string",
          "default": "#2563eb"
        },
        "greeting": {
          "type": "string",
          "default": "Hi! How can we help?"
        }
      },
      "additionalProperties": false
    },
    "ui": "ui/settings.html"
  },
  "rpc": ["conversations.list", "conversations.reply"],
  "rpc_permissions": {
    "conversations.list": "plugins.read",
    "conversations.reply": "plugins.write"
  },
  "jobs": [
    {
      "name": "sync-conversations",
      "schedule": "*/5 * * * *"
    }
  ],
  "build": {
    "build_id": "2026-11-10T10:00:00Z"
  }
}
