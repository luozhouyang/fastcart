{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fastcart.dev/schemas/storefront-artifact/manifest.schema.json",
  "title": "FastCart SSR Artifact Manifest",
  "description": "Versioned contract between a framework build and the FastCart universal SSR runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "framework",
    "runtime",
    "entry",
    "assets",
    "rendering",
    "build"
  ],
  "properties": {
    "schema_version": {
      "const": "1",
      "description": "Manifest schema version understood by FastCart."
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$",
      "description": "Stable artifact identity."
    },
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "compatibility_date"],
      "properties": {
        "engine": {
          "const": "workerd"
        },
        "compatibility_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "compatibility_flags": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,128}$"
          },
          "uniqueItems": true,
          "default": []
        },
        "required_capabilities": {
          "type": "array",
          "items": {
            "enum": ["fetch", "streams", "web-crypto", "timers", "url", "nodejs-compat"]
          },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": {
          "const": "worker"
        },
        "path": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*\\.(?:js|mjs)$",
          "description": "Bundle-relative path to the Worker module."
        },
        "export": {
          "type": "string",
          "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*$",
          "default": "default"
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory", "base_path"],
      "properties": {
        "directory": {
          "type": "string",
          "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$",
          "description": "Bundle-relative client asset directory."
        },
        "base_path": {
          "type": "string",
          "pattern": "^/(?![/])(?!.*\\.\\.)[A-Za-z0-9._~!$&'()*+,;=:@%/-]*$",
          "description": "Public URL prefix served by Rust."
        }
      }
    },
    "rendering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "streaming"],
      "properties": {
        "mode": {
          "enum": ["static", "ssr", "hybrid"]
        },
        "streaming": {
          "type": "boolean"
        }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_id", "created_at"],
      "properties": {
        "build_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
